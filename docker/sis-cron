#!/bin/sh
# Cron role: runs Moodle cron every minute. Never installs or upgrades; only the app
# container writes the schema. No need to wait for the app: cron.php refuses to run
# while the site is installing or upgrading, and the next minute tries again.
set -eu

echo "sis-cron: running"
while true; do
    php /app/moodle/admin/cli/cron.php || echo "sis-cron: cron.php exited $?"
    sleep 60
done
