#!/usr/bin/env bash
# Docker smoke tests: build the images, run a throwaway site from host/compose.yml, check it,
# then tear it down. The suites live in tests/smoke/.
# Usage: bin/smoke [<suite>] [<institution>]
#   install [<inst>]   install a fresh site and check it serves (the default; base image unless named)
#   env                mail, curl, SMTP and Redis per SIS_ENV, with Mailpit and Redis beside it
#   backup [<inst>]    back up a seeded site, check every refusal, restore it (default: demo)
#   upgrade            the pre-upgrade backup through install, upgrades and a rollback
#   all [<inst>]       the four in turn, stopping at the first failure; <inst> goes to install and backup
# Every suite: SMOKE_PORT (its own default), SMOKE_TIMEOUT=600, SMOKE_KEEP=1 (leave it running;
# not with all). install only: SMOKE_ENV='KEY=value' (extra .env lines), SMOKE_IMAGE=<image>.
set -euo pipefail
cd "$(dirname "$0")/.."

suites=(install env backup upgrade)
usage() {
  local d names=""
  for d in institutions/*/; do
    d=$(basename "$d")
    [[ "$d" == _* ]] || names+=" $d"
  done
  # By its path from the repo root: $0 may be relative to where it was started.
  sed -n '4,11p' bin/smoke | sed 's/^# //' >&2
  echo "institutions:$names" >&2
  exit 64
}
is_suite() {
  local s
  for s in "${suites[@]}" all; do [[ "$1" == "$s" ]] && return 0; done
  return 1
}

for s in "${suites[@]}" all; do
  if [[ -d "institutions/$s" ]]; then
    echo "smoke: institutions/$s is named like a suite; rename it" >&2
    exit 64
  fi
done

suite=install
if [[ $# -gt 0 ]] && is_suite "$1"; then suite=$1; shift; fi
[[ $# -le 1 ]] || usage
inst=${1:-}
if [[ -n "$inst" ]]; then
  [[ "$inst" != _* && -d "institutions/$inst" ]] || usage
  [[ "$suite" != env && "$suite" != upgrade ]] || usage
fi

if [[ "$suite" != all ]]; then
  exec bash "tests/smoke/$suite.sh" ${inst:+"$inst"}
fi
if [[ "${SMOKE_KEEP:-}" == 1 ]]; then
  echo "smoke: SMOKE_KEEP=1 can't be used with all: a kept stack holds the ports the next suite needs" >&2
  exit 64
fi
for s in "${suites[@]}"; do
  case "$s" in
    install|backup) bash "tests/smoke/$s.sh" ${inst:+"$inst"} ;;
    *) bash "tests/smoke/$s.sh" ;;
  esac
done
echo "smoke: all suites passed"
