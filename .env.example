# Local development settings for compose.yml (bin/dev). Copy to .env to change any of
# them; every line is optional and shows the default. Hosts use host/.env.example instead.
# The institution to build is chosen per run: INSTITUTION=demo bin/dev up

# Ports on this machine
DEV_PORT=8300
MAILPIT_PORT=8325

# The site's address, by default http://localhost:<DEV_PORT>. Another container, such as SIS,
# can't reach localhost: set this machine's network IP and DEV_PORT instead, for example
# http://192.168.0.5:8300, and use that address in the browser too, since Moodle redirects
# any other host to it.
WWWROOT=

# Site name shown on the dev site
SITE_FULLNAME=Moodle (dev)

# Read by settings.json ${VAR} references and by local_sisexample
SISEXAMPLE_REMOTE_URL=https://remote.example.test
SISEXAMPLE_SSO_ISSUER=
SISEXAMPLE_SSO_CLIENT_ID=
SISEXAMPLE_SSO_SECRET=

# Mail goes to the mailpit service unless this points elsewhere
SMTP_HOSTS=mailpit:1025
SMTP_NOREPLY=noreply@example.com

# A Redis server for sessions; empty keeps them in moodledata
REDIS_HOST=
