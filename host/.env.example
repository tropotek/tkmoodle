# Which image to run
INSTITUTION=demo
TAG=latest

# Which environment this is: local, development, uat or production. Required: the site
# refuses to start without it. development never sends mail; local lets curl reach any
# host and port. On a server it must agree with the host's marker in /etc/tkmoodle:
# https://tropotek.github.io/tkmoodle/configuration/#host-markers
SIS_ENV=
# Servers only: the absolute path of the folder holding this host's environment marker.
# Create the folder and its marker first:
# https://tropotek.github.io/tkmoodle/configuration/#host-markers
# Left unset, nothing on the host is read and only SIS_ENV=local starts.
# SIS_HOST_DIR=/etc/tkmoodle

# Public address. An https:// address makes Caddy fetch a Let's Encrypt certificate
# for its hostname; http:// serves plain HTTP (local use).
WWWROOT=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Database (DB_HOST=db is the bundled container). COMPOSE_PROFILES=db runs that container;
# for an external MySQL 8.4 server, remove that line and set the DB_* values below.
COMPOSE_PROFILES=db
DB_HOST=db
DB_PORT=3306
DB_NAME=moodle
DB_USER=moodle
DB_PASS=change-me

# Outgoing mail. Set, each is read-only in Moodle's admin pages; empty, the admin sets it
# there. SMTP_HOSTS is host:port.
SMTP_HOSTS=
SMTP_USER=
SMTP_PASS=
SMTP_NOREPLY=

# Redis server for Moodle's sessions; empty keeps them in moodledata. Nothing here runs
# Redis: point it at a server this host can reach, one per site.
REDIS_HOST=

# First install only
SITE_FULLNAME=Moodle
ADMIN_PASS=change-me
ADMIN_EMAIL=admin@example.com

# Read by settings.json ${VAR} references and by local_sisexample
SISEXAMPLE_REMOTE_URL=
SISEXAMPLE_SSO_ISSUER=
SISEXAMPLE_SSO_CLIENT_ID=
SISEXAMPLE_SSO_SECRET=
