# Which image to run
INSTITUTION=demo
TAG=latest

# Public address. Locally: WWWROOT=http://localhost and SERVER_NAME=http://:80.
# On a server: WWWROOT=https://moodle.example.com and SERVER_NAME=moodle.example.com
# (Caddy then gets a Let's Encrypt certificate).
WWWROOT=http://localhost
SERVER_NAME=http://:80
CADDY_GLOBAL_OPTIONS=
HTTP_PORT=80
HTTPS_PORT=443

# Database (DB_HOST=db is the bundled container)
DB_TYPE=mysqli
DB_HOST=db
DB_PORT=3306
DB_NAME=moodle
DB_USER=moodle
DB_PASS=change-me
DB_ROOT_PASS=change-me-too
DB_PREFIX=mdl_
DB_WAIT_TIMEOUT=120

# First install only
SITE_FULLNAME=Moodle
SITE_SHORTNAME=moodle
ADMIN_USER=admin
ADMIN_PASS=change-me
ADMIN_EMAIL=admin@example.com

# Read by settings.json ${VAR} references and by local_sisexample
SISEXAMPLE_REMOTE_URL=
SISEXAMPLE_SSO_ISSUER=
SISEXAMPLE_SSO_CLIENT_ID=
SISEXAMPLE_SSO_SECRET=
